---
import PageLayout from "../layouts/PageLayout.astro";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Kontakt — Capygator",
  description:
    "Kontaktseite von Capygator — Power BI & Microsoft Fabric Experte im DACH-Raum. Projektanfragen und Erstgespräche.",
  url: "https://capygator.com/kontakt",
  mainEntity: {
    "@type": "Person",
    name: "Ulf Papenfuß",
    jobTitle: "Power BI & Microsoft Fabric Experte",
    email: "info@capygator.com",
    url: "https://capygator.com",
    worksFor: {
      "@type": "ProfessionalService",
      name: "Capygator",
      url: "https://capygator.com",
    },
  },
};
---

<PageLayout
  schema={contactSchema}
  title="Kontakt — Projekt besprechen | Capygator"
  description="Power BI, Microsoft Fabric oder Agentic AI — sprechen Sie mit dem DACH-Experten über Ihr Datenprojekt. Ich melde mich innerhalb von 24 Stunden."
>
  <section class="page-hero">
    <div class="container hero-split">
      <div class="hero-content">
        <p class="page-label animate-fade-up delay-2">Kontakt</p>
        <h1 class="page-title animate-fade-up delay-3">
          Lassen Sie uns<br />
          <span class="text-accent">sprechen.</span>
        </h1>
        <p class="page-sub animate-fade-up delay-4">
          Schreiben Sie mir — ich melde mich innerhalb von 24 Stunden.<br />
          Oder direkt per E-Mail an <a href="mailto:info@capygator.com" class="text-accent"
            >info@capygator.com</a
          >
        </p>
      </div>
      <div class="hero-logo animate-fade-up delay-3">
        <img src="/images/capy-medaillon.png" alt="Capygator Logo" width="360" height="360" />
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-form-wrapper animate-fade-up delay-5">
        <div
          aria-live="polite"
          aria-atomic="true"
          id="form-status"
          class="form-status-message"
          tabindex="-1"
        >
        </div>
        <form
          action="https://formspree.io/f/mbdzngkq"
          method="POST"
          class="contact-form"
          id="contact-form"
          novalidate
        >
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name <span class="required-mark" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                required
                aria-required="true"
                placeholder="Ihr Name"
              />
            </div>
            <div class="form-group">
              <label for="company">Unternehmen</label>
              <input type="text" id="company" name="company" placeholder="Firma (optional)" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email"
                >E-Mail <span class="required-mark" aria-hidden="true">*</span></label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                aria-required="true"
                placeholder="ihre@email.de"
              />
            </div>
            <div class="form-group">
              <label for="package">Interesse an</label>
              <select id="package" name="package">
                <option value="">— Bitte wählen —</option>
                <option value="sprint">Sprint (5 Tage)</option>
                <option value="projekt">Projekt (20 Tage)</option>
                <option value="partnerschaft">Partnerschaft (200 Tage)</option>
                <option value="unsicher">Noch unsicher</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="message"
              >Nachricht <span class="required-mark" aria-hidden="true">*</span></label
            >
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              aria-required="true"
              placeholder="Erzählen Sie mir kurz von Ihrem Vorhaben..."></textarea>
          </div>
          <div class="form-footer">
            <button type="submit" class="form-submit">
              Nachricht senden
              <svg
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
              >
            </button>
            <p class="form-note">
              Kein Callcenter, keine Warteschleife — Sie schreiben direkt mir.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    padding: 10rem 0 4rem;
    position: relative;
    z-index: 2;
  }

  .hero-split {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
  }

  .hero-content {
    flex: 1;
  }

  .hero-logo {
    flex-shrink: 0;
    opacity: 0.15;
  }

  .hero-logo img {
    display: block;
  }

  .page-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
  }

  .page-sub {
    font-size: 1.1rem;
    max-width: 500px;
    color: var(--color-text-secondary);
  }

  .contact-section {
    padding: 2rem 0 6rem;
    position: relative;
    z-index: 2;
  }

  /* FORM */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    padding: 0.75rem 1rem;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-text-muted);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .required-mark {
    color: var(--color-accent);
  }

  .form-status-message {
    min-height: 1.5rem;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .form-status-message.success {
    color: var(--color-accent);
  }

  .form-status-message.error {
    color: #ff6b6b;
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group select option {
    background: var(--color-bg-primary);
  }

  .form-submit {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.85rem 2rem;
    border-radius: var(--radius-button);
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-display);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.25s;
    align-self: flex-start;
  }

  .form-submit:hover {
    background: var(--color-accent-bright);
    box-shadow: 0 4px 40px var(--color-accent-dim);
    transform: translateY(-2px);
  }

  .form-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .form-note {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .hero-split {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-logo {
      display: none;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status");

  if (form && statusEl) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitBtn.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          statusEl.textContent =
            "Danke! Ihre Nachricht wurde gesendet. Ich melde mich innerhalb von 24 Stunden.";
          statusEl.className = "form-status-message success";
          form.reset();
          statusEl.focus();
        } else {
          throw new Error("Fehler beim Senden");
        }
      } catch {
        statusEl.textContent =
          "Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder schreiben Sie direkt an info@capygator.com.";
        statusEl.className = "form-status-message error";
        statusEl.focus();
        submitBtn.disabled = false;
      }
    });
  }
</script>
