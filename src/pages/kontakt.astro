---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Kontakt — Projekt besprechen | Capygator"
  description="Lassen Sie uns über Ihr Daten-Projekt sprechen. Ich melde mich innerhalb von 24 Stunden."
>
  <section class="page-hero">
    <div class="container hero-split">
      <div class="hero-content">
        <p class="page-label animate-fade-up delay-2">Kontakt</p>
        <h1 class="page-title animate-fade-up delay-3">
          Lassen Sie uns<br />
          <span class="text-accent">sprechen.</span>
        </h1>
        <p class="page-sub animate-fade-up delay-4">
          Schreiben Sie mir — ich melde mich innerhalb von 24 Stunden.<br />
          Oder direkt per E-Mail an <a href="mailto:info@capygator.com" class="text-accent">info@capygator.com</a>
        </p>
      </div>
      <div class="hero-logo animate-fade-up delay-3">
        <img src="/images/capy-medaillon.png" alt="Capygator Logo" width="360" height="360" />
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-form-wrapper animate-fade-up delay-5">
        <form
          action="https://formspree.io/f/[DEINE-FORMSPREE-ID]"
          method="POST"
          class="contact-form"
        >
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Ihr Name" />
            </div>
            <div class="form-group">
              <label for="company">Unternehmen</label>
              <input type="text" id="company" name="company" placeholder="Firma (optional)" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">E-Mail</label>
              <input type="email" id="email" name="email" required placeholder="ihre@email.de" />
            </div>
            <div class="form-group">
              <label for="package">Interesse an</label>
              <select id="package" name="package">
                <option value="">— Bitte wählen —</option>
                <option value="sprint">Sprint (5 Tage)</option>
                <option value="projekt">Projekt (20 Tage)</option>
                <option value="partnerschaft">Partnerschaft (200 Tage)</option>
                <option value="unsicher">Noch unsicher</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="message">Nachricht</label>
            <textarea id="message" name="message" rows="6" required placeholder="Erzählen Sie mir kurz von Ihrem Vorhaben..."></textarea>
          </div>
          <div class="form-footer">
            <button type="submit" class="form-submit">
              Nachricht senden
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
            <p class="form-note">Kein Callcenter, keine Warteschleife — Sie schreiben direkt mir.</p>
          </div>
        </form>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    padding: 10rem 0 4rem;
    position: relative;
    z-index: 2;
  }

  .hero-split {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
  }

  .hero-content {
    flex: 1;
  }

  .hero-logo {
    flex-shrink: 0;
    opacity: 0.15;
  }

  .hero-logo img {
    display: block;
  }

  .page-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
  }

  .page-sub {
    font-size: 1.1rem;
    max-width: 500px;
    color: var(--color-text-secondary);
  }

  .contact-section {
    padding: 2rem 0 6rem;
    position: relative;
    z-index: 2;
  }

  /* FORM */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    padding: 0.75rem 1rem;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-text-muted);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group select option {
    background: var(--color-bg-primary);
  }

  .form-submit {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.85rem 2rem;
    border-radius: var(--radius-button);
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-display);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.25s;
    align-self: flex-start;
  }

  .form-submit:hover {
    background: var(--color-accent-bright);
    box-shadow: 0 4px 40px var(--color-accent-dim);
    transform: translateY(-2px);
  }

  .form-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .form-note {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .hero-split {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-logo {
      display: none;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
