---
import PageLayout from "../layouts/PageLayout.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import CTABanner from "../components/sections/CTABanner.astro";
import HeroDiagram from "../components/ui/HeroDiagram.astro";

const fabricIcon = `<svg width="24" height="24" fill="none" stroke="#00e5a0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`;
const pbiIcon = `<svg width="24" height="24" fill="none" stroke="#00e5a0" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 2.5 2.5L17 9"/><circle cx="17" cy="9" r="1.5" fill="#00e5a0"/></svg>`;
const aiIcon = `<svg width="24" height="24" fill="none" stroke="#00e5a0" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>`;

const homeSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Capygator",
    url: "https://capygator.com",
    description:
      "Power BI & Microsoft Fabric Experte für den DACH-Mittelstand. Strategie, Architektur und Agentic Engineering — aus einer Hand.",
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: "https://capygator.com/?q={search_term_string}",
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Ulf Papenfuß",
    jobTitle: "Power BI & Microsoft Fabric Experte",
    url: "https://capygator.com",
    email: "info@capygator.com",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Am Meinerhof 5",
      postalCode: "31600",
      addressLocality: "Uchte",
      addressCountry: "DE",
    },
    worksFor: {
      "@type": "ProfessionalService",
      name: "Capygator",
      url: "https://capygator.com",
    },
    knowsAbout: [
      "Microsoft Power BI",
      "Microsoft Fabric",
      "Business Intelligence",
      "Semantic Modeling",
      "DAX",
      "Agentic Engineering",
      "Anthropic Claude",
    ],
    areaServed: [
      { "@type": "Country", name: "Germany" },
      { "@type": "Country", name: "Austria" },
      { "@type": "Country", name: "Switzerland" },
    ],
  },
];
---

<PageLayout
  schema={homeSchemas}
  title="Capygator — Power BI & Fabric Experte | DACH"
  description="Calm on complexity. Power BI, Microsoft Fabric & Agentic Engineering für den DACH-Mittelstand — aus einer Hand. Ihr Datenprojekt, souverän begleitet."
>
  <!-- LCP: Preload hero image für schnelles Rendering -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/capy-hero-zen-640w.avif"
    imagesrcset="/images/capy-hero-zen-640w.avif 640w, /images/capy-hero-zen-890w.avif 890w"
    imagesizes="100vw"
    fetchpriority="high"
  />
  <!-- DATA TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span>POWER BI</span><span class="ticker-dot"></span>
      <span>MICROSOFT FABRIC</span><span class="ticker-dot"></span>
      <span>SEMANTIC MODELS</span><span class="ticker-dot"></span>
      <span>AGENTIC ENGINEERING</span><span class="ticker-dot"></span>
      <span>DAX OPTIMIZATION</span><span class="ticker-dot"></span>
      <span>LAKEHOUSE</span><span class="ticker-dot"></span>
      <span>DATA GOVERNANCE</span><span class="ticker-dot"></span>
      <span>POWER BI</span><span class="ticker-dot"></span>
      <span>MICROSOFT FABRIC</span><span class="ticker-dot"></span>
      <span>SEMANTIC MODELS</span><span class="ticker-dot"></span>
      <span>AGENTIC ENGINEERING</span><span class="ticker-dot"></span>
      <span>DAX OPTIMIZATION</span><span class="ticker-dot"></span>
      <span>LAKEHOUSE</span><span class="ticker-dot"></span>
      <span>DATA GOVERNANCE</span><span class="ticker-dot"></span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <picture class="hero-bg-color" data-hero-color>
        <source
          type="image/avif"
          srcset="/images/capy-hero-zen-640w.avif 640w, /images/capy-hero-zen-890w.avif 890w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/capy-hero-zen-640w.webp 640w, /images/capy-hero-zen-890w.webp 890w"
          sizes="100vw"
        />
        <img
          src="/images/capy-hero-zen.png"
          alt=""
          width="890"
          height="508"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <picture class="hero-bg-sw" data-hero-sw>
        <source
          type="image/avif"
          srcset="/images/capy-hero-zen-640w.avif 640w, /images/capy-hero-zen-890w.avif 890w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/capy-hero-zen-640w.webp 640w, /images/capy-hero-zen-890w.webp 890w"
          sizes="100vw"
        />
        <img
          src="/images/capy-hero-zen.png"
          alt=""
          width="890"
          height="508"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="hero-overlay" data-hero-overlay></div>
    <div class="container">
      <div class="hero-split">
        <!-- Left: Content -->
        <div class="hero-content">
          <h1 class="hero-title animate-fade-up delay-2">
            Calm on<br />complexity.
          </h1>

          <p class="hero-desc animate-fade-up delay-3">
            Ihre Daten sind da. Ihre Entscheidungen warten. Ich bringe beides zusammen — mit
            Power BI, Microsoft Fabric und AI.
          </p>

          <div class="hero-actions animate-fade-up delay-4">
            <a href="/kontakt" class="btn-primary">
              Projekt besprechen
              <svg
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
              >
            </a>
            <a href="/preise" class="btn-secondary">Preise ansehen</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIAGRAM -->
  <section class="diagram-section">
    <div class="container">
      <HeroDiagram />
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services">
    <div class="container">
      <div class="section-header">
        <span class="section-number">01</span>
        <h2 class="section-title">Leistungen</h2>
      </div>

      <div class="services-grid">
        <a href="/fabric" class="service-card service-card--large">
          <div class="service-icon" set:html={fabricIcon} />
          <h3>Microsoft Fabric</h3>
          <p>
            Die meisten Fabric-Projekte scheitern nicht an der Technologie. Sondern daran, dass
            niemand das Gesamtbild hat.
          </p>
          <span class="service-arrow">&rarr;</span>
        </a>

        <a href="/power-bi" class="service-card">
          <div class="service-icon" set:html={pbiIcon} />
          <h3>Power BI</h3>
          <p>
            Ihre Reports laden 30 Sekunden? Das liegt nicht an der Hardware. Es liegt am
            Datenmodell.
          </p>
          <span class="service-arrow">&rarr;</span>
        </a>

        <a href="/agentic-engineering" class="service-card">
          <div class="service-card-number">03</div>
          <div class="service-icon" set:html={aiIcon} />
          <h3>Agentic Engineering</h3>
          <p>
            80&thinsp;% jeder Pipeline ist Boilerplate. AI schreibt den Code, der Mensch reviewt das
            Ergebnis.
          </p>
          <span class="service-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST SIGNALS -->
  <section class="trust-section">
    <div class="container">
      <div class="section-header">
        <span class="section-number">02</span>
        <h2 class="section-title">Warum Capygator</h2>
      </div>
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-badge">
            <svg
              width="18"
              height="18"
              fill="none"
              stroke="#00e5a0"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              ><path
                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
              ></path></svg
            >
            20 Jahre Erfahrung
          </div>
          <p>Enterprise-BI &amp; Data Engineering<br />vom klassischen Data Warehouse bis Microsoft Fabric</p>
        </div>
        <div class="trust-item">
          <div class="trust-badge">
            <svg
              width="18"
              height="18"
              fill="none"
              stroke="#00e5a0"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              ><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"
              ></circle><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"></path></svg
            >
            Fabric-Früh-Adopter
          </div>
          <p>Einer der frühesten Microsoft-Fabric-<br />Adopter in Deutschland</p>
        </div>
        <div class="trust-item">
          <div class="trust-badge">
            <svg
              width="18"
              height="18"
              fill="none"
              stroke="#00e5a0"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
              ></polyline></svg
            >
            20+ Projekte
          </div>
          <p>Datenplattformen von 50 bis 800<br />Personentagen Umfang</p>
        </div>
        <div class="trust-item">
          <div class="trust-badge">
            <svg
              width="18"
              height="18"
              fill="none"
              stroke="#00e5a0"
              stroke-width="1.5"
              viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
            >
            Konzern bis Mittelstand
          </div>
          <p>DACH — Energie, Automotive, Pharma,<br />Banken, Handel, Logistik</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="proof-section">
    <div class="container">
      <div class="section-header">
        <span class="section-number">03</span>
        <h2 class="section-title">Ausgewählte Projekte</h2>
      </div>
      <div class="proof-grid">
        <div class="proof-card">
          <p class="proof-quote">
            End-to-End-Fabric-Plattform aufgebaut: Medallion-Architektur, Anbindung Dynamics 365
            F&amp;O, automatisiertes Deployment über drei Environments.
          </p>
          <footer class="proof-meta">
            <span class="proof-name">Energie &amp; Maschinenbau</span>
            <span class="proof-company">120 Personentage</span>
          </footer>
        </div>
        <div class="proof-card">
          <p class="proof-quote">
            Microsoft Fabric, Snowflake und Databricks vergleichend evaluiert und regulatorisch
            (BCBS 239) bewertet — als Basis für eine fundierte Plattformentscheidung.
          </p>
          <footer class="proof-meta">
            <span class="proof-name">Bank &amp; Finanz</span>
            <span class="proof-company">120 Personentage</span>
          </footer>
        </div>
        <div class="proof-card">
          <p class="proof-quote">
            Reporting-Landschaft von SAP BusinessObjects auf Power BI und Fabric migriert —
            technische Projektleitung bis zum eigenständigen Team.
          </p>
          <footer class="proof-meta">
            <span class="proof-name">Pharma-Großhandel</span>
            <span class="proof-company">400 Personentage</span>
          </footer>
        </div>
        <div class="proof-card">
          <p class="proof-quote">
            BI Competence Center strategisch beraten, Power-BI-Teams gecoacht und eine zentrale
            Analytics-Plattform etabliert.
          </p>
          <footer class="proof-meta">
            <span class="proof-name">Automotive-Konzern</span>
            <span class="proof-company">500 Personentage</span>
          </footer>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    headline="30 Minuten, die sich lohnen."
    subline="Kostenloses Erstgespräch — ich analysiere Ihre Situation und zeige konkrete nächste Schritte."
  />
</PageLayout>

<style>
  /* TICKER */
  .ticker {
    position: relative;
    z-index: 2;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    padding: 0.6rem 0;
    margin-top: 4rem;
  }

  .ticker-track {
    display: flex;
    gap: 2rem;
    animation: scroll-ticker 30s linear infinite;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .ticker-dot {
    width: 4px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 50%;
    flex-shrink: 0;
    align-self: center;
  }

  @keyframes scroll-ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* HERO */
  .hero {
    padding: 8rem 0 4rem;
    position: relative;
    z-index: 2;
    min-height: clamp(520px, 42vw, 820px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-bg picture {
    display: block;
    position: absolute;
    inset: 0;
  }

  .hero-bg picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .hero-bg-color {
    display: block;
  }
  .hero-bg-sw {
    display: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(10, 11, 13, 0.9) 0%,
      rgba(10, 11, 13, 0.6) 45%,
      rgba(10, 11, 13, 0.35) 100%
    );
    z-index: -1;
  }

  .hero-split {
    display: block;
    max-width: 640px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
  }

  .hero-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-primary);
    max-width: 480px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.15s;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.2s;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
  }

  .btn-secondary:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  /* DIAGRAM */
  .diagram-section {
    padding: 0;
    position: relative;
    z-index: 2;
  }

  /* SECTION HEADERS */
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  /* SERVICES */
  .services {
    padding: 5rem 0;
    position: relative;
    z-index: 2;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-bg-card);
    padding: 2.5rem 2rem;
    text-decoration: none;
    transition: background 0.3s;
    position: relative;
    min-height: 280px;
  }

  .service-card:hover {
    background: var(--color-bg-card-hover);
  }

  .service-card-number {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
  }

  .service-card .service-icon {
    width: 40px;
    height: 40px;
    background: var(--color-accent-dim);
    border: 1px solid var(--color-accent-mid);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-text-primary);
  }

  .service-card p {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .service-arrow {
    font-size: 1.2rem;
    color: var(--color-accent);
    transition: transform 0.2s;
    align-self: flex-end;
  }

  .service-card:hover .service-arrow {
    transform: translateX(4px);
  }

  /* TRUST SIGNALS */
  .trust-section {
    padding: 5rem 0;
    position: relative;
    z-index: 2;
    background: var(--color-bg-secondary);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
  }

  .trust-item p {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* SOCIAL PROOF */
  .proof-section {
    padding: 5rem 0;
    position: relative;
    z-index: 2;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 900px;
  }

  .proof-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .proof-quote {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .proof-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .proof-name {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-primary);
    font-family: var(--font-display);
  }

  .proof-company {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .hero {
      min-height: 400px;
      padding: 6rem 0 3rem;
    }
    .hero-split {
      max-width: 100%;
    }
    .hero-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .trust-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
