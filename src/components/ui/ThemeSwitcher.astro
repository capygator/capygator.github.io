---

---

<div class="theme-switcher" data-theme-switcher>
  <button class="theme-toggle" data-theme-toggle aria-label="Theme wechseln">
    <span class="theme-icon" data-theme-icon>
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        ><circle cx="12" cy="12" r="5"></circle><path
          d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
        ></path></svg
      >
    </span>
    <span class="theme-label" data-theme-label>Capygator</span>
  </button>
  <div class="theme-panel" data-theme-panel hidden>
    <div class="theme-panel-header">Theme</div>
    <button class="theme-option active" data-theme-option="capygator">
      <span class="theme-preview theme-preview--capygator">
        <span class="theme-preview-bar"></span>
        <span class="theme-preview-line"></span>
        <span class="theme-preview-line short"></span>
      </span>
      <span class="theme-option-name">Capygator</span>
    </button>
    <button class="theme-option" data-theme-option="notebook">
      <span class="theme-preview theme-preview--notebook">
        <span class="theme-preview-bar"></span>
        <span class="theme-preview-line"></span>
        <span class="theme-preview-line short"></span>
      </span>
      <span class="theme-option-name">Notebook</span>
    </button>
  </div>
</div>

<style>
  .theme-switcher {
    position: fixed;
    bottom: 1.5rem;
    right: 10.5rem;
    z-index: 200;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.6rem 1rem;
    color: var(--color-text-primary);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s;
    font-family: var(--font-body);
    font-size: 0.8rem;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent-mid);
    background: var(--color-bg-card-hover);
  }

  .theme-icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
  }

  .theme-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .theme-panel {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    width: 200px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .theme-panel[hidden] {
    display: none;
  }

  .theme-panel-header {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0.5rem 0.75rem 0.4rem;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.15s,
      border-color 0.15s;
    color: var(--color-text-primary);
    width: 100%;
  }

  .theme-option:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-border);
  }

  .theme-option.active {
    background: var(--color-accent-dim);
    border-color: var(--color-accent-mid);
  }

  .theme-option-name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Theme previews */
  .theme-preview {
    width: 36px;
    height: 26px;
    border-radius: 4px;
    padding: 4px 5px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
    border: 1px solid;
  }

  .theme-preview--capygator {
    background: #0a0b0d;
    border-color: #1e2130;
  }

  .theme-preview--capygator .theme-preview-bar {
    width: 60%;
    height: 3px;
    background: #00e5a0;
    border-radius: 1px;
  }

  .theme-preview--capygator .theme-preview-line {
    width: 100%;
    height: 2px;
    background: #2a2e42;
    border-radius: 1px;
  }

  .theme-preview--capygator .theme-preview-line.short {
    width: 65%;
  }

  .theme-preview--notebook {
    background: #f9f9f9;
    border-color: #747272;
  }

  .theme-preview--notebook .theme-preview-bar {
    width: 60%;
    height: 3px;
    background: #5d4037;
    border-radius: 1px;
  }

  .theme-preview--notebook .theme-preview-line {
    width: 100%;
    height: 2px;
    background: #dedede;
    border-radius: 1px;
  }

  .theme-preview--notebook .theme-preview-line.short {
    width: 65%;
  }

  @media (max-width: 768px) {
    .theme-switcher {
      bottom: 1rem;
      right: 9rem;
    }
  }
</style>

<script>
  const themes = {
    capygator: {
      "--color-bg-primary": "#0a0b0d",
      "--color-bg-secondary": "#111318",
      "--color-bg-card": "#16181e",
      "--color-bg-card-hover": "#1c1f27",
      "--color-accent": "#00e5a0",
      "--color-accent-dim": "rgba(0, 229, 160, 0.12)",
      "--color-accent-mid": "rgba(0, 229, 160, 0.3)",
      "--color-accent-bright": "#00ffb2",
      "--color-text-primary": "#edf0f7",
      "--color-text-secondary": "#8b91a3",
      "--color-text-muted": "#555b6e",
      "--color-border": "#1e2130",
      "--color-border-hover": "#2a2e42",
    },
    notebook: {
      "--color-bg-primary": "#f9f9f9",
      "--color-bg-secondary": "#f0efe8",
      "--color-bg-card": "#ffffff",
      "--color-bg-card-hover": "#f5f3eb",
      "--color-accent": "#5d4037",
      "--color-accent-dim": "rgba(93, 64, 55, 0.1)",
      "--color-accent-mid": "rgba(93, 64, 55, 0.25)",
      "--color-accent-bright": "#4e342e",
      "--color-text-primary": "#3a3a3a",
      "--color-text-secondary": "#505050",
      "--color-text-muted": "#808080",
      "--color-border": "#c8c4b8",
      "--color-border-hover": "#a09a8c",
    },
  };

  function applyTheme(themeName: string) {
    if (!(themeName in themes)) return;
    const vars = themes[themeName as keyof typeof themes];
    const root = document.documentElement;
    for (const [prop, value] of Object.entries(vars)) {
      root.style.setProperty(prop, value);
    }
    // Font-body wird vom FontSwitcher gesteuert, nicht vom Theme

    // Switch hero background image
    const heroColor = document.querySelector("[data-hero-color]") as HTMLElement;
    const heroSw = document.querySelector("[data-hero-sw]") as HTMLElement;
    const heroOverlay = document.querySelector("[data-hero-overlay]") as HTMLElement;
    if (heroColor && heroSw) {
      if (themeName === "notebook") {
        heroColor.style.display = "none";
        heroSw.style.display = "block";
      } else {
        heroColor.style.display = "block";
        heroSw.style.display = "none";
      }
    }
    if (heroOverlay) {
      heroOverlay.style.background =
        themeName === "notebook" ? "rgba(249, 249, 249, 0.7)" : "rgba(10, 11, 13, 0.6)";
    }
  }

  const toggle = document.querySelector("[data-theme-toggle]");
  const panel = document.querySelector("[data-theme-panel]");
  const label = document.querySelector("[data-theme-label]");
  const options = document.querySelectorAll("[data-theme-option]");

  // Restore saved theme on page load
  const savedTheme = localStorage.getItem("capygator-theme") || "capygator";
  applyTheme(savedTheme);
  if (label) {
    label.textContent = savedTheme === "capygator" ? "Capygator" : "Notebook";
  }
  options.forEach((o) => {
    o.classList.toggle("active", (o as HTMLElement).dataset.themeOption === savedTheme);
  });

  toggle?.addEventListener("click", () => {
    const isHidden = panel?.hasAttribute("hidden");
    if (isHidden) {
      panel?.removeAttribute("hidden");
    } else {
      panel?.setAttribute("hidden", "");
    }
  });

  document.addEventListener("click", (e) => {
    const switcher = document.querySelector("[data-theme-switcher]");
    if (switcher && !switcher.contains(e.target as Node)) {
      panel?.setAttribute("hidden", "");
    }
  });

  options.forEach((option) => {
    option.addEventListener("click", () => {
      const themeName = (option as HTMLElement).dataset.themeOption;
      if (!themeName) return;

      applyTheme(themeName);
      localStorage.setItem("capygator-theme", themeName);

      if (label) {
        label.textContent = themeName === "capygator" ? "Capygator" : "Notebook";
      }

      options.forEach((o) => o.classList.remove("active"));
      option.classList.add("active");
      panel?.setAttribute("hidden", "");
    });
  });
</script>
