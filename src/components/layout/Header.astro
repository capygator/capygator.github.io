---
const navItems = [
  { label: 'Fabric', href: '/fabric' },
  { label: 'Power BI', href: '/power-bi' },
  { label: 'Agentic Engineering', href: '/agentic-engineering' },
  { label: 'Preise', href: '/preise' },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav" aria-label="Hauptnavigation">
  <div class="nav-inner container">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Capygator — Startseite">
      <span class="nav-logo-text">
        capy<span class="text-accent">gator</span>
      </span>
    </a>

    <!-- Desktop Links -->
    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath === item.href || currentPath.startsWith(item.href + '/') }]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a href="/kontakt" class="nav-cta">Projekt besprechen</a>

    <!-- Mobile Toggle -->
    <button
      class="nav-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="nav-mobile" data-mobile-menu hidden>
    <ul class="nav-mobile-links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="nav-mobile-link">{item.label}</a>
        </li>
      ))}
      <li>
        <a href="/kontakt" class="nav-mobile-cta">Projekt besprechen</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(20px);
    background: oklch(from var(--color-bg-primary) l c h / 0.85);
    border-bottom: 1px solid var(--color-border);
    animation: fadeDown 0.6s var(--ease-out-expo);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .nav-logo-img {
    border-radius: 6px;
    object-fit: contain;
  }

  .nav-logo-text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.2s;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-cta {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8rem;
    font-family: var(--font-display);
    transition: opacity 0.15s;
  }

  .nav-cta:hover {
    opacity: 0.9;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    padding: 1.5rem var(--spacing-container-sm);
  }

  .nav-mobile[hidden] {
    display: none !important;
  }

  .nav-mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-mobile-link {
    display: block;
    padding: 0.75rem 0;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.2s;
  }

  .nav-mobile-link:hover {
    color: var(--color-text-primary);
  }

  .nav-mobile-cta {
    display: inline-block;
    margin-top: 1rem;
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-display);
    text-align: center;
    width: 100%;
  }

  @media (max-width: 768px) {
    .nav-links,
    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    .nav-mobile:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.hasAttribute('hidden');
    if (isOpen) {
      menu?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      menu?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });
</script>
