---
const navItems = [
  { label: 'Fabric', href: '/fabric' },
  { label: 'Power BI', href: '/power-bi' },
  { label: 'Agentic Engineering', href: '/agentic-engineering' },
  { label: 'Preise', href: '/preise' },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav" aria-label="Hauptnavigation">
  <div class="nav-inner container">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Capygator — Startseite">
      <span class="nav-logo-text">
        capy<span class="text-accent">gator</span>
      </span>
    </a>

    <!-- Desktop Links -->
    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath === item.href || currentPath.startsWith(item.href + '/') }]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a href="/kontakt" class="nav-cta">Projekt besprechen</a>

    <!-- Mobile Toggle -->
    <button
      class="nav-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="burger-bar bar1"></span>
      <span class="burger-bar bar2"></span>
      <span class="burger-bar bar3"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="nav-mobile" data-mobile-menu aria-hidden="true">
    <ul class="nav-mobile-links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="nav-mobile-link">{item.label}</a>
        </li>
      ))}
      <li>
        <a href="/kontakt" class="nav-mobile-cta">Projekt besprechen</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(20px);
    background: oklch(from var(--color-bg-primary) l c h / 0.85);
    border-bottom: 1px solid var(--color-border);
    animation: fadeDown 0.6s var(--ease-out-expo);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .nav-logo-img {
    border-radius: 6px;
    object-fit: contain;
  }

  .nav-logo-text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.2s;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-cta {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8rem;
    font-family: var(--font-display);
    transition: opacity 0.15s;
  }

  .nav-cta:hover {
    opacity: 0.9;
  }

  /* Hamburger toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0.5rem;
    width: 40px;
    height: 40px;
  }

  .burger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.2s ease, width 0.3s ease;
    transform-origin: center;
  }

  /* Hamburger → X animation */
  .nav-toggle[aria-expanded="true"] .bar1 {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .bar2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle[aria-expanded="true"] .bar3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile dropdown */
  .nav-mobile {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      max-height 0.4s var(--ease-out-expo),
      opacity 0.25s ease,
      transform 0.3s var(--ease-out-expo);
    border-top: 1px solid transparent;
    background: var(--color-bg-primary);
    backdrop-filter: blur(20px);
  }

  .nav-mobile.is-open {
    max-height: 480px;
    opacity: 1;
    transform: translateY(0);
    border-top-color: var(--color-border);
  }

  .nav-mobile-links {
    list-style: none;
    margin: 0;
    padding: 1.25rem var(--spacing-container-sm);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-mobile-link {
    display: block;
    padding: 0.75rem 0;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.2s, padding-left 0.2s;
  }

  .nav-mobile-link:hover {
    color: var(--color-text-primary);
    padding-left: 0.5rem;
  }

  .nav-mobile-cta {
    display: block;
    margin-top: 1rem;
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-display);
    text-align: center;
    width: 100%;
  }

  @media (max-width: 768px) {
    .nav-links,
    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('is-open');
    if (isOpen) {
      menu?.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
      menu?.setAttribute('aria-hidden', 'true');
    } else {
      menu?.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
      menu?.setAttribute('aria-hidden', 'false');
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const nav = document.querySelector('.nav');
    if (nav && !nav.contains(e.target as Node)) {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
    }
  });

  // Close on nav link click (mobile)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
    });
  });
</script>
