---
interface Props {
  headline?: string;
  subline?: string;
}

const {
  headline = "Projekt besprechen?",
  subline = "Ich freue mich auf ein unverbindliches Erstgespräch über Ihre Daten-Herausforderungen.",
} = Astro.props;
---

<section class="cta-banner">
  <div class="container cta-inner">
    <h2 class="cta-headline">{headline}</h2>
    <p class="cta-subline">{subline}</p>
    <div class="cta-actions">
      <a href="/kontakt" class="cta-btn-primary">
        Erstgespräch vereinbaren
        <svg
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
        >
      </a>
      <a href="/preise" class="cta-btn-secondary">Preise ansehen ↓</a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    z-index: 2;
    padding: 5rem 0;
  }

  .cta-inner {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 4rem 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-inner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }

  .cta-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .cta-subline {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 480px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .cta-btn-primary {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    font-family: var(--font-display);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.15s;
  }

  .cta-btn-primary:hover {
    opacity: 0.9;
  }

  .cta-btn-secondary {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .cta-btn-secondary:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .cta-inner {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
