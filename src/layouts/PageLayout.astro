---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import FontSwitcher from "../components/ui/FontSwitcher.astro";
import ThemeSwitcher from "../components/ui/ThemeSwitcher.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object | object[];
}

const { title, description, ogImage, schema } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} schema={schema}>
  <slot name="head" slot="head" />
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <ThemeSwitcher />
  <FontSwitcher />
</BaseLayout>
