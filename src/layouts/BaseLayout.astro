---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object | object[];
}

const {
  title,
  description,
  ogImage = '/images/capygator-og.png',
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// BreadcrumbList auto-generieren für alle Unterseiten
const pathNames: Record<string, string> = {
  'fabric': 'Microsoft Fabric',
  'power-bi': 'Power BI',
  'agentic-engineering': 'Agentic Engineering',
  'preise': 'Preise',
  'kontakt': 'Kontakt',
  'impressum': 'Impressum',
  'datenschutz': 'Datenschutz',
};
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": Astro.site?.toString().replace(/\/$/, '') || '',
    },
    ...pathSegments.map((segment, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": pathNames[segment] || segment,
      "item": new URL('/' + pathSegments.slice(0, i + 1).join('/'), Astro.site).toString(),
    })),
  ],
} : null;

import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Capygator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:alt" content="Capygator — Power BI & Microsoft Fabric Experte" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts (critical) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Datatype:wght@400;700&display=swap" rel="stylesheet" />

    <!-- Spline CDN -->
    <link rel="preconnect" href="https://prod.spline.design" />

    <!-- Schema.org: BreadcrumbList -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Schema.org: Seitenspezifische Daten -->
    {schema && (
      Array.isArray(schema)
        ? schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Capygator",
      "description": "Power BI & Microsoft Fabric Experte in der DACH-Region. Strategie, Implementierung, Coaching.",
      "url": Astro.site?.toString(),
      "logo": new URL('/images/capygator-logo.png', Astro.site).toString(),
      "priceRange": "€€€",
      "areaServed": [
        { "@type": "Country", "name": "Germany" },
        { "@type": "Country", "name": "Austria" },
        { "@type": "Country", "name": "Switzerland" }
      ],
      "knowsAbout": [
        "Microsoft Power BI",
        "Microsoft Fabric",
        "Business Intelligence",
        "Data Analytics",
        "Semantic Modeling",
        "Agentic Engineering"
      ]
    })} />
  </head>
  <body>
    <script is:inline>
      // Apply saved theme/font immediately to prevent flash
      (function() {
        var t = localStorage.getItem('capygator-theme');
        if (t === 'notebook') {
          var r = document.documentElement;
          r.style.setProperty('--color-bg-primary','#f9f9f9');
          r.style.setProperty('--color-bg-secondary','#f0efe8');
          r.style.setProperty('--color-bg-card','#ffffff');
          r.style.setProperty('--color-bg-card-hover','#f5f3eb');
          r.style.setProperty('--color-accent','#5d4037');
          r.style.setProperty('--color-accent-dim','rgba(93,64,55,0.1)');
          r.style.setProperty('--color-accent-mid','rgba(93,64,55,0.25)');
          r.style.setProperty('--color-accent-bright','#4e342e');
          r.style.setProperty('--color-text-primary','#3a3a3a');
          r.style.setProperty('--color-text-secondary','#505050');
          r.style.setProperty('--color-text-muted','#808080');
          r.style.setProperty('--color-border','#c8c4b8');
          r.style.setProperty('--color-border-hover','#a09a8c');
        }
        var f = localStorage.getItem('capygator-font-family');
        if (f) {
          r = document.documentElement;
          r.style.setProperty('--font-display', f);
          r.style.setProperty('--font-body', f);
        }
      })();
    </script>
    <!-- Page content -->
    <slot />

    <!-- Scroll-triggered animations via IntersectionObserver -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
